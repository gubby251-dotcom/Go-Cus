
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function login() {
      return request.auth != null;
    }

    function admin() {
      return login()
        && request.auth.token.admin == true;
    }

    function akunSaya(uid) {
      return login() && request.auth.uid == uid;
    }

    function profilDisetujui(role) {
      return login()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == role
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == 'disetujui';
    }

    // Profil pengguna
    match /users/{uid} {
      allow create: if akunSaya(uid)
        && request.resource.data.keys().hasOnly([
          'nama', 'email', 'role', 'status', 'dibuatPada',
          'nomorPlat', 'fotoProfil', 'nomorHp', 'alamat'
        ])
        && request.resource.data.keys().hasAll([
          'nama', 'email', 'role', 'status', 'dibuatPada'
        ])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in [
          'pelanggan', 'pemilik-warung', 'mitra'
        ]
        && request.resource.data.status == 'menunggu-persetujuan'
        && (
          request.resource.data.role != 'mitra'
          || (
            request.resource.data.keys().hasAll(['nomorPlat', 'fotoProfil'])
            && request.resource.data.nomorPlat is string
            && request.resource.data.nomorPlat.size() >= 4
            && request.resource.data.nomorPlat.size() <= 12
            && request.resource.data.fotoProfil is string
            && request.resource.data.fotoProfil.size() <= 400000
            && request.resource.data.fotoProfil.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          )
        );

      allow read: if akunSaya(uid) || admin();

      // Pengguna hanya boleh mengubah nama.
      // Peran dan status persetujuan hanya dapat diubah Admin.
      allow update: if admin()
        || (
          akunSaya(uid)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['nama', 'nomorHp', 'alamat', 'diperbaruiPada'])
          && request.resource.data.nama is string
          && (!('nomorHp' in request.resource.data) || request.resource.data.nomorHp is string)
          && (!('alamat' in request.resource.data) || request.resource.data.alamat is string)
        );

      allow delete: if admin();
    }

    // Profil warung
    match /shops/{shopId} {
      allow read: if resource.data.verified == true || admin()
        || akunSaya(shopId);

      allow create: if akunSaya(shopId)
        && profilDisetujui('pemilik-warung')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.verified == false;

      allow update: if admin()
        || (
          akunSaya(shopId)
          && profilDisetujui('pemilik-warung')
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.verified == resource.data.verified
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'namaWarung', 'deskripsi', 'diperbaruiPada'
            ])
        );

      allow delete: if admin();

      // Menu warung
      match /menus/{menuId} {
        allow read: if admin()
          || akunSaya(shopId)
          || (
            get(
              /databases/$(database)/documents/shops/$(shopId)
            ).data.verified == true
            && resource.data.statusPersetujuan == 'disetujui'
            && resource.data.tersedia == true
          );

        allow create: if akunSaya(shopId)
          && profilDisetujui('pemilik-warung')
          && get(
            /databases/$(database)/documents/shops/$(shopId)
          ).data.verified == true
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.statusPersetujuan == 'menunggu'
          && request.resource.data.harga is number
          && request.resource.data.harga > 0;

        allow update: if admin()
          || (
            akunSaya(shopId)
            && profilDisetujui('pemilik-warung')
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.statusPersetujuan
              == resource.data.statusPersetujuan
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'nama', 'deskripsi', 'harga',
                'tersedia', 'diperbaruiPada'
              ])
          );

        allow delete: if admin();
      }
    }

    // Pesanan: belum boleh ditulis langsung oleh aplikasi.
    // Aktifkan setelah backend checkout selesai.
    match /orders/{orderId} {
      allow read: if admin()
        || (
          login()
          && (
            resource.data.customerUid == request.auth.uid
            || resource.data.driverUid == request.auth.uid
            || resource.data.ownerUid == request.auth.uid
          )
        );

      allow create, update, delete: if false;
    }

    // Dompet dan buku transaksi hanya boleh dikelola backend tepercaya.
    match /wallets/{uid} {
      allow read: if akunSaya(uid) || admin();
      allow write: if false;
    }

    match /walletTransactions/{transactionId} {
      allow read: if admin()
        || (
          login()
          && resource.data.uid == request.auth.uid
        );

      allow write: if false;
    }

    // Default: semua koleksi lain ditolak sampai aturannya dibuat.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
