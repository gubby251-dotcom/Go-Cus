
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }

    function isOwnerApproved(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'pemilik-warung'
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'disetujui';
    }

    function isCustomerApproved() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pelanggan'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'disetujui';
    }

    // PROFIL PENGGUNA
    match /users/{uid} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'nama', 'email', 'role', 'status', 'dibuatPada'
        ])
        && request.resource.data.nama is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in [
          'pelanggan', 'pemilik-warung', 'mitra'
        ]
        && request.resource.data.status == 'menunggu-persetujuan';

      allow read: if isSignedIn()
        && (request.auth.uid == uid || isAdmin());

      // Pengguna tidak boleh mengubah sendiri role/status.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['nama'])
          && request.resource.data.nama is string
        );

      allow delete: if isAdmin();
    }

    // PROFIL WARUNG
    match /shops/{shopId} {
      allow read: if resource.data.verified == true
        || isAdmin()
        || (isSignedIn() && request.auth.uid == shopId);

      allow create: if isOwnerApproved(shopId)
        && request.resource.data.ownerUid == shopId
        && request.resource.data.verified == false
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'namaWarung', 'deskripsi',
          'verified', 'dibuatPada', 'diperbaruiPada'
        ]);

      allow update: if isAdmin()
        || (
          isOwnerApproved(shopId)
          && request.auth.uid == shopId
          && resource.data.ownerUid == shopId
          && request.resource.data.ownerUid == shopId
          && request.resource.data.verified == resource.data.verified
        );

      allow delete: if isAdmin();

      // MENU WARUNG
      match /menus/{menuId} {
        allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid == shopId)
          || (
            get(/databases/$(database)/documents/shops/$(shopId)).data.verified == true
            && resource.data.statusPersetujuan == 'disetujui'
            && resource.data.tersedia == true
          );

        allow create: if isOwnerApproved(shopId)
          && request.auth.uid == shopId
          && get(/databases/$(database)/documents/shops/$(shopId)).data.verified == true
          && request.resource.data.ownerUid == shopId
          && request.resource.data.statusPersetujuan == 'menunggu'
          && request.resource.data.tersedia == true
          && request.resource.data.harga is number
          && request.resource.data.harga > 0;

        allow update: if isAdmin()
          || (
            isOwnerApproved(shopId)
            && request.auth.uid == shopId
            && resource.data.ownerUid == shopId
            && request.resource.data.ownerUid == shopId
            && request.resource.data.statusPersetujuan == resource.data.statusPersetujuan
          );

        allow delete: if isAdmin()
          || (
            isOwnerApproved(shopId)
            && request.auth.uid == shopId
          );
      }
    }

    // PESANAN
    match /orders/{orderId} {
      allow create: if isCustomerApproved()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'menunggu'
        && request.resource.data.keys().hasOnly([
          'customerUid', 'detail', 'status', 'dibuatPada'
        ]);

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.customerUid == request.auth.uid
        )
        || (
          isSignedIn()
          && resource.data.driverUid == request.auth.uid
        );

      // Status dan penugasan driver harus diatur oleh
      // alur otorisasi yang terverifikasi, bukan pelanggan.
      allow update, delete: if isAdmin();
    }

    // Semua koleksi lain ditolak secara default.
  }
}
